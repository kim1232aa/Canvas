# ComfyCanvas Studio — environment variables actually read by server.ts
# Copy to .env and fill values. NEVER commit real keys.
# Keys can also be entered in Web「后台设置」(localStorage); request headers override when present.
# Priority typical: request header (x-*-key) > settings pool > process.env

# --- Optional app ---
APP_URL=""
CANVAS_ADMIN_TOKEN=""
CANVAS_SETTINGS_SECRET=""
CANVAS_PROVIDER_KEYS=""
CANVAS_PROXY_CA=""

# --- Google Gemini ---
GEMINI_API_KEY=""

# --- Fal.ai ---
# Comma-separated multi-key OK (round-robin across requests).
FAL_KEY=""

# --- Civitai ---
CIVITAI_API_KEY=""
# Some routes also accept CIVITAI_API_TOKEN as alias
CIVITAI_API_TOKEN=""

# --- Hugging Face ---
# Comma-separated multi-key OK (same as Fal). Billing/402 may try the next pool key on generate.
# A single x-hf-token request header pins that one key (no rotate).
HF_TOKEN=""

# --- ModelScope (CN vs AI are separate accounts/tokens) ---
MODELSCOPE_TOKEN=""
MODELSCOPE_AI_TOKEN=""

# --- NanoGPT ---
NANOGPT_KEY=""
NANOGPT_BASE_URL=""

# --- Tensor.Art ---
# OpenWorks tool key looks like ak_tensor_... — ONLY for OpenWorks tools, NOT TAMS model API.
# TAMS model generation needs a TAMS Bearer from https://tams.tensor.art/app — do not mix.
TENSORART_API_KEY=""

# --- Agnes AI (either name works) ---
AGNES_API_KEY=""
AGNES_KEY=""
AGNES_BASE_URL=""

# --- SenseNova ---
SENSENOVA_KEY=""
SENSENOVA_BASE_URL=""

# --- MuAPI / WaveSpeed / Sogni ---
MUAPI_KEY=""
WAVESPEED_KEY=""
SOGNI_KEY=""
# Together AI (https://api.together.ai) — image + video
KREA_API_KEY=
TOGETHER_API_KEY=
# AIMLAPI (https://api.aimlapi.com) — image (+ video async)
AIMLAPI_KEY=
# Novita AI (https://api.novita.ai) — SD async txt2img + task-result; LoRA model_name+strength
NOVITA_API_KEY=
# Venice (https://api.venice.ai/api/v1) — image sync + video async queue
VENICE_API_KEY=

# --- Runware ---
RUNWARE_API_KEY=""
RUNWARE_KEY=""
RUNWARE_BASE_URL=""

# --- ModelsLab ---
MODELSLAB_API_KEY=""
MODELSLAB_KEY=""
MODELSLAB_BASE_URL=""

# --- Replicate ---
REPLICATE_API_TOKEN=""
REPLICATE_API_KEY=""
REPLICATE_BASE_URL=""

# --- OpenAI-compatible image relay (NOT official OpenAI; you must set Base URL) ---
OPENAI_COMPAT_IMAGE_BASE_URL=""
OPENAI_COMPAT_IMAGE_API_KEY=""

# --- Grok / xAI-compatible relay (NOT official xAI; missing /v1 is appended by server) ---
GROK_COMPAT_BASE_URL=""
GROK_COMPAT_API_KEY=""
