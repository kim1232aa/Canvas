{
  "$schemaNote": "草案 — 仅声明。真相源: docs/provider-api-audit-v2/together.md + DIFF.md (2026-10-15)",
  "id": "together",
  "displayName": "Together",
  "domainTypes": {
    "ImageJob": "{ prompt, model, seed?, steps?, guidance_scale?, width?, height?, n?, negative_prompt?, response_format?, output_format? }",
    "VideoJob": "{ model, prompt?, seed?, seconds?, fps?, width?, height?, resolution?, ratio?, negative_prompt? }",
    "CatalogRow": "{ id, type: image|video, display_name?, pricing? }"
  },
  "auth": {
    "envVar": "TOGETHER_API_KEY",
    "header": "Authorization",
    "scheme": "Bearer",
    "sources": [
      "https://docs.together.ai/docs/api-keys-authentication.md"
    ]
  },
  "base": {
    "v1": "https://api.together.ai/v1",
    "v2": "https://api.together.ai/v2",
    "note": "视频走 v2 /videos；图生走 v1 /images/generations"
  },
  "catalog": {
    "method": "GET",
    "path": "/models",
    "root": "v1",
    "query": {
      "dedicated": {
        "type": "boolean",
        "optional": true
      }
    },
    "pagination": "none_documented",
    "search": "none_documented",
    "rowFilter": "type === 'image' || type === 'video'",
    "sources": [
      "https://docs.together.ai/reference/models.md"
    ]
  },
  "image": {
    "mode": "sync",
    "method": "POST",
    "path": "/images/generations",
    "root": "v1",
    "required": [
      "prompt",
      "model"
    ],
    "parameters": {
      "seed": {
        "type": "integer",
        "supported": true
      },
      "steps": {
        "type": "integer",
        "default": 20
      },
      "guidance_scale": {
        "type": "number",
        "default": 3.5
      },
      "width": {
        "type": "integer",
        "default": 1024
      },
      "height": {
        "type": "integer",
        "default": 1024
      },
      "n": {
        "type": "integer",
        "default": 1,
        "min": 1,
        "max": 4
      },
      "negative_prompt": {
        "type": "string"
      },
      "response_format": {
        "enum": [
          "url",
          "base64"
        ]
      },
      "output_format": {
        "enum": [
          "jpeg",
          "png"
        ]
      },
      "disable_safety_checker": {
        "type": "boolean"
      }
    },
    "outputs": "data[].url | data[].b64_json",
    "poll": null,
    "sources": [
      "https://docs.together.ai/reference/post-images-generations.md",
      "https://docs.together.ai/docs/inference/images/parameters.md"
    ]
  },
  "video": {
    "supported": true,
    "mode": "async",
    "create": {
      "method": "POST",
      "path": "/videos",
      "root": "v2"
    },
    "poll": {
      "method": "GET",
      "path": "/videos/{id}",
      "root": "v2",
      "suggestedIntervalSec": 60,
      "statuses": [
        "queued",
        "in_progress",
        "completed",
        "failed",
        "cancelled"
      ],
      "successField": "outputs.video_url",
      "errorField": "error.message / error.code"
    },
    "parameters": {
      "seed": {
        "type": "integer",
        "supported": true
      },
      "seconds": {
        "type": "string",
        "range": "1-10"
      },
      "fps": {
        "type": "integer",
        "rangeDoc": "15-60"
      },
      "width": {
        "type": "integer"
      },
      "height": {
        "type": "integer"
      },
      "resolution": {
        "type": "string",
        "note": "Wan 2.7 等用 720P/1080P"
      },
      "ratio": {
        "type": "string"
      },
      "prompt": {
        "type": "string"
      }
    },
    "lora": {
      "supported": false,
      "reason": "视频参数页/OpenAPI 未文档化 LoRA；勿挂假强度"
    },
    "sources": [
      "https://docs.together.ai/docs/inference/videos/overview.md",
      "https://docs.together.ai/docs/inference/videos/parameters.md",
      "https://docs.together.ai/reference/create-videos.md",
      "https://docs.together.ai/reference/get-videos-id.md"
    ]
  },
