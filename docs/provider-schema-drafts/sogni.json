{
  "canvasAcceptance": "未验证（2026-10-17 14:40 北京：测试截图已全删，按雁标准「画布里出图、落保存节点、历史有缩略图」当前 0 家；以前的出图/欠费标记一律作废，官方字段结论保留；在画布重跑出图并有节点图+历史缩略图后再单独改）",
  "$schemaNote": "草案 — 仅声明。真相源: docs/provider-api-audit-v2/sogni.md（04:43–04:45 修正版）+ DIFF.md",
  "id": "sogni",
  "displayName": "Sogni",
  "auth": {
    "envVar": "SOGNI_API_KEY",
    "header": "Authorization",
    "scheme": "Bearer",
    "alt": "api-key header",
    "idempotency": [
      "Idempotency-Key",
      "X-Idempotency-Key"
    ]
  },
  "base": {
    "root": "https://api.sogni.ai/v1"
  },
  "catalog": {
    "image": "GET /model-catalog?mediaType=image",
    "notImage": "GET /models 只列 LLM，禁止当图像目录",
    "loraPublic": {
      "path": "GET /loras/comfy?modelId=<workerModelId>",
      "auth": false,
      "rowFields": [
        "loraId",
        "modelIds",
        "restrictedModelIds",
        "ui.min",
        "ui.max",
        "ui.default",
        "ui.step",
        "ui.recommendedMin",
        "ui.recommendedMax"
      ],
      "note": "无 key 200；强度范围逐条在 ui.*；服务端会 clamp 越界值 → 画布应按 ui 本地校验"
    },
    "loraPersonal": {
      "path": "GET /loras/personal | /loras/personal/catalog",
      "auth": true,
      "requires": "Unlimited plan"
    },
    "namespaceWarning": "worker modelId（如 krea2_turbo_fp8_scaled）≠ workflow model selector（如 krea-2-turbo）；无官方映射时不得改写",
    "pagination": "none_documented",
    "imageNote": "OpenAI 兼容 /v1/images/generations 实测 404；图像走 creative-agent/workflows"
  },
  "predict": {
    "mode": "async workflow",
    "create": {
      "method": "POST",
      "path": "/creative-agent/workflows",
      "body": "input: { title, steps: [{ id, toolName, arguments, dependsOn? }] } + token_type/billing_mode/confirm_cost/max_estimated_capacity_units/safe_content_filter/media_references",
      "responses": {
        "201": "inline steps created",
        "202": "template awaiting cost confirm"
      },
      "note": "201/202 不是完成态"
    },
    "poll": [
      "GET /creative-agent/workflows/:id",
      "GET /creative-agent/workflows/:id/events",
      "SSE /creative-agent/workflows/:id/events/stream"
    ],
    "control": [
      "POST :id/resume",
      "POST :id/confirm-cost",
      "POST :id/cancel",
      "POST :id/reseed"
    ],
    "statuses": [
      "queued",
      "running",
      "completed",
      "partial_failure",
      "waiting_for_user",
      "failed",
      "cancelled"
    ],
    "nonSuccessRule": "partial_failure / waiting_for_user 不得当完成",
    "outputs": "workflow.steps[i].artifacts[j].url"
  },
  "image": {
    "toolName": "generate_image",
    "arguments": {
      "prompt": true,
      "model": "workflow selector",
      "width": true,
      "height": true,
      "loras": true,
      "loraStrengths": true
    },
    "seed": {
      "supported": true,
      "type": "Uint32",
      "via": [
        "SDK seed",
        "POST :id/reseed seed_overrides"
      ],
      "caveat": "多图只固定其中一张"
    },
    "stepsGuidance": {
      "source": "SDK ImageProjectParams",
      "note": "workflow 示例常只传 prompt+model；采样字段勿硬编码"
    }
  },
  "video": {
    "supported": true,
    "toolNames": {
      "generate_video": "t2v / reference",
      "animate_photo": "i2v",
      "others": [
        "sound_to_video",
        "video_to_video",
        "stitch_video",
        "orbit_video",
        "extend_video"
      ]
    },
    "arguments": {
      "videoModel": [
        "ltx25(default)",
        "ltx23",
        "wan22",
        "minimax-h3-*",
        "seedance2",
        "seedance2-mini",
        "seedance2-5",
        "happyhorse-1.1-*",
        "wan3.0-video",
        "wan3.0-spicy-video"
      ],
      "durationByModel": {
        "ltx": "2-20s",
        "seedance2/mini": "4-15s",
        "seedance2-5": "4-30s",
        "happyhorse": "3-15s",
        "wan3": "2-30s",
        "h3": "~5.2-15.1s @24fps"
      },
      "size": [
        "ratio",
        "aspectRatio",
        "width+height",
        "targetResolution 480/720/1080 (Seedance 2.0 可 4K)"
      ],
      "flags": [
        "generateAudio",
        "expandPrompt",
        "watermark",
        "keyframes",
        "sourceAudioPolicy"
      ],
      "loras": "仅部分 minimax-h3 模式"
    },
    "fps": {
      "supported": false,
      "reason": "无通用 fps 参数；H3 源片要求 24fps"
    },
    "seed": "reseed seed_overrides；省略则随机"
  },
  "lora": {
    "fields": {
      "loras": "string[] (catalog slug | personal-…)",
      "loraStrengths": "number[] 等长按位；亦接受 lora_strengths"
    },
    "defaultStrength": {
      "value": 1.0,
      "documented": true,
      "note": "省略 loraStrengths 时全部 1.0（非 catalog default）"
    },
    "maxItems": {
      "value": 8,
