{
  "$schemaNote": "草案 — 仅声明。真相源: docs/provider-api-audit-v2/fal.md + DIFF.md (2026-10-15)",
  "id": "fal",
  "displayName": "fal.ai",
  "auth": {
    "envVar": "FAL_KEY",
    "header": "Authorization",
    "scheme": "Key",
    "note": "是 Key 不是 Bearer；禁止浏览器端暴露"
  },
  "base": {
    "queue": "https://queue.fal.run",
    "platform": "https://api.fal.ai/v1"
  },
  "catalog": {
    "global": {
      "path": "GET https://api.fal.ai/v1/models",
      "auth": false,
      "query": [
        "q",
        "category",
        "status",
        "limit",
        "cursor",
        "expand"
      ],
      "note": "无 key 200（v2 实测 fal_models.json）；旧审计称无公开目录已否"
    },
    "perEndpointOpenAPI": "https://fal.ai/api/openapi/queue/openapi.json?endpoint_id=<id>（无 key）；部分 expand=openapi-3.0 会 expansion_failed → 改用本 URL",
    "pricing": "GET https://api.fal.ai/v1/models/pricing?endpoint_id=…（需 Key）"
  },
  "predict": {
    "mode": "async queue",
    "create": {
      "method": "POST",
      "path": "/{model_id}"
    },
    "status": {
      "method": "GET",
      "path": "/{model_id}/requests/{request_id}/status?logs=1"
    },
    "result": {
      "method": "GET",
      "path": "/{model_id}/requests/{request_id}"
    },
    "cancel": {
      "method": "PUT",
      "path": "/{model_id}/requests/{request_id}/cancel"
    },
    "statuses": [
      "IN_QUEUE",
      "IN_PROGRESS",
      "COMPLETED"
    ],
    "webhook": "fal_webhook="
  },
  "image": {
    "fal-ai/flux-lora": {
      "seed": {
        "type": "integer",
        "echoed": true
      },
      "num_inference_steps": {
        "type": "integer",
        "default": 28,
        "canvasField": "steps"
      },
      "guidance_scale": {
        "type": "number",
        "default": 3.5,
        "canvasField": "cfg"
      },
      "image_size": {
        "anyOf": [
          "enum preset",
          "{width,height}"
        ],
        "canvasMapping": "width+height → image_size"
      },
      "loras": {
        "maxItems": "any (merged)"
      }
    },
    "fal-ai/krea-2/turbo/lora": {
      "seed": {
        "type": "integer",
        "note": "image i uses seed+i"
      },
      "image_size": {
        "default": "square_hd",
        "enum": [
          "square_hd",
          "square",
          "portrait_4_3",
          "portrait_16_9",
          "landscape_4_3",
          "landscape_16_9"
        ],
        "orObject": "{width,height} ≤14142"
      },
      "num_images": true,
      "acceleration": true,
      "enable_prompt_expansion": true,
      "output_format": true,
      "num_inference_steps": {
        "supported": false
      },
      "guidance_scale": {
        "supported": false
      },
      "loras": {
        "maxItems": 3
      },
      "openapiVerified": "2026-10-15 queue openapi.json Krea2TurboLoraInput：无 num_inference_steps/guidance_scale；loras maxItems 3；scale 0-4"
    }
  },
  "video": {
    "supported": true,
    "outputShape": "video {url,…}（非 images[]）",
    "fal-ai/wan-t2v-lora": {
