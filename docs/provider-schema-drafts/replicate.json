{
  "$schemaNote": "草案 — 仅声明。2026-11-03：出站以模型版本实时 openapi_schema 为准；示例参数（flux-dev-lora）会过期，不写死尺寸字段名；本地快照不当真相。",
  "id": "replicate",
  "displayName": "Replicate",
  "auth": {
    "envVar": "REPLICATE_API_TOKEN",
    "header": "Authorization",
    "scheme": "Bearer",
    "keyRule": "只进环境变量/本机配置，禁止写入草案；群里明文建议轮换"
  },
  "base": {
    "root": "https://api.replicate.com/v1"
  },
  "catalog": {
    "list": "GET /models",
    "search": "GET /models (search)",
    "get": "GET /models/{owner}/{name}",
    "versions": "GET /models/{owner}/{name}/versions",
    "schema": "GET /models/{owner}/{name}/versions/{id} → openapi_schema",
    "rule": "输入字段按模型版本 openapi_schema 动态读取；非全局统一 body",
    "noSchemaRule": "无 live OpenAPI Input.properties 且无静态表行 → 旧版本地拦截（blocked:schema_missing）已撤销，改为照发 POST /predictions，上游返回原样显示；证据 docs/evidence/replicate-noschema-block-2026-10-15.md",
    "schemaPolicy": "逐版本实时 openapi_schema；不写死尺寸字段名（2026-11-03）"
  },
  "predict": {
    "mode": "async (default) | sync via Prefer: wait[=N]",
    "create": [
      "POST /predictions (community, needs version)",
      "POST /models/{owner}/{name}/predictions (official)",
      "POST /deployments/{owner}/{name}/predictions"
    ],
    "poll": {
      "method": "GET",
      "path": "/predictions/{id}",
      "statuses": [
        "starting",
        "processing",
        "succeeded",
        "failed",
        "canceled"
      ]
    },
    "cancel": "POST /predictions/{id}/cancel",
    "webhook": [
      "webhook",
      "webhook_events_filter"
    ],
    "outputNote": "file URL 下载可能需带 Authorization"
  },
  "image": {
    "exampleModel": "black-forest-labs/flux-dev-lora",
    "parameters": {
      "seed": {
        "type": "integer",
        "supported": true,
        "caveat": "go_fast=true 时不保证确定性"
      },
      "go_fast": {
        "type": "boolean",
        "default": true
      },
      "guidance": {
        "type": "number",
        "default": 3,
        "min": 0,
        "max": 10,
        "canvasField": "cfg"
      },
      "num_inference_steps": {
        "type": "integer",
        "default": 28,
        "min": 1,
        "max": 50,
        "canvasField": "steps"
      },
      "aspect_ratio": {
        "type": "enum",
        "default": "1:1",
        "note": "无独立 width/height"
      },
      "megapixels": {
        "enum": [
          "1",
          "0.25"
        ],
        "default": "1"
      },
      "prompt_strength": {
        "type": "number",
        "default": 0.8,
        "range": "0-1",
        "when": "img2img"
      },
      "output_format": {
        "enum": [
          "webp",
          "jpg",
          "png"
        ],
        "default": "webp"
      },
      "output_quality": {
        "type": "integer",
        "default": 80,
        "range": "0-100"
      },
      "num_outputs": true,
      "disable_safety_checker": {
        "type": "boolean",
        "default": false
      }
    },
    "widthHeight": {
      "supported": false,
      "reason": "flux-schnell / flux-dev-lora / flux-schnell-lora 均无 width/height；用 aspect_ratio+megapixels（2026-11-03）"
